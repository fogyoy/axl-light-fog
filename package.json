{
  "name": "axl-light-fog",
  "version": "0.4.0",
  "private": true,
  "description": "基于 Axl Light 的中文维护版，为 Markdown 与 PDF 提供独立旁注。",
  "main": "main.js",
  "scripts": {
    "test": "node tests/regression.mjs && node tests/anchorCore.mjs && node tests/workflow.mjs && python3 tests/e2e-safety.py && node tests/cli-target.mjs && node tests/merge-safety.mjs",
    "test:obsidian": "python3 tests/obsidian-e2e.py",
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "package": "node scripts/package.mjs",
    "check:public": "node scripts/check-public.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run package && npm run check:public",
    "test:setup": "node scripts/test-vault.mjs",
    "release": "node scripts/release.mjs",
    "install:local": "node scripts/install.mjs",
    "rollback:local": "node scripts/rollback.mjs",
    "test:installation": "node tests/installation.mjs",
    "merge": "node scripts/merge.mjs"
  },
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "^20.14.10",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "31.0.1",
    "obsidian": "^1.7.2",
    "tslib": "^2.8.1",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "fast-diff": "1.3.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-math": "3.1.0",
    "micromark-util-decode-string": "2.0.1"
  },
  "engines": {
    "node": "26.13.0"
  }
}
